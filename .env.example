# Modelo de configuracao. Copie para .env.local e preencha la.
# Este arquivo e versionado: NUNCA preencha valores reais aqui.

# URL do projeto Supabase (painel: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica anonima do Supabase (painel: Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta de servico. Ignora todas as regras de acesso do banco (RLS).
# Usada apenas pelos scripts de linha de comando.
# NUNCA utilizar prefixo NEXT_PUBLIC_ ou expor no cliente!
SUPABASE_SERVICE_ROLE_KEY=
